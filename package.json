{
  "name": "dsh-archive-trash",
  "version": "0.2.0",
  "description": "DSH 归档会话清理 🗑️ 会话行上一键删、批量清空、可还原回收站，还会自动清理指向已删文件的僵尸条目。只动会话日志，不碰工作目录。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "archive",
    "session",
    "trash",
    "cleanup"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongdougao111/dsh-archive-trash.git"
  },
  "homepage": "https://github.com/hongdougao111/dsh-archive-trash#readme",
  "bugs": {
    "url": "https://github.com/hongdougao111/dsh-archive-trash/issues"
  },
  "license": "MIT"
}
